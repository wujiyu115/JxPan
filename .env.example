# 复制成 .env 后按需填写；docker compose 会自动读取。
# 网盘凭据全部可选 —— 推荐进 /admin 用扫码登录，凭据会加密写进 SQLite。

# ===== 后台管理面板 =====
ADMIN_USER=admin
ADMIN_PASS=change_me

# ===== 宿主进程 =====
# NAS 上 ./data 属主与容器内 node(1000) 不一致时改这两个
PUID=1000
PGID=1000
# 挂在反代后面保持 true，false 会导致短链使用内网地址
TRUST_PROXY=true

# ===== 网盘凭据（可选，兜底用）=====
# 阿里云盘
ALIYUN_AUTHORIZATION=
ALIYUN_ENABLED=
# 夸克网盘
QK_COOKIE=
QK_ENABLED=
# UC 网盘
UC_COOKIE=
UC_ENABLED=
# 移动云盘
MCLOUD_AUTHORIZATION=
MCLOUD_COOKIE=
MCLOUD_ENABLED=
# 天翼云盘
CLOUD189_TOKEN=
# 123 云盘
PAN123_TOKEN=
PAN123_AUTHORIZATION=
PAN123_ENABLED=
# 光鸭云盘
GY_Login=
GY_ENABLED=
# 小飞机网盘（大于 500MB 的文件需要账号）
FEIJI_USER=
FEIJI_PASS=

# ===== Aria2 / RPC 推送（Motrix、AriaNg、Aria2 Tools）=====
# 也可以在页面右下角「⚙ Aria2」里填，UI 填的会覆盖这里的值
# 完整地址。Motrix 默认端口 16800，aria2c 默认 6800
ARIA2_RPC_URL=
# RPC 密钥，无密钥留空
ARIA2_RPC_TOKEN=
# aria2 那一侧的保存目录
ARIA2_DIR=
# 推送方式：auto（默认）/ direct / jxpan
#   auto   能直推就直推网盘直链（aria2 直连 CDN，不过 JxPan）：
#          UC / 天翼 / 123 / 蓝奏优享 裸直链即可；
#          夸克 / 光鸭 自动补 Cookie、Referer、专用 UA；
#          阿里云盘的请求头无法从混淆代码复刻，退回 JxPan 链接
#   direct 全部强制直推（阿里可能 403，自负风险）
#   jxpan  全部走 JxPan 的 type=down 链接，兼容性最好
ARIA2_PUSH_MODE=auto
# 只有退回 JxPan 链接时才用到：aria2 拿它回连 JxPan。
# 留空即用请求本身的地址；aria2 在别的容器/机器上时不能是 127.0.0.1。
PUBLIC_BASE_URL=
# 默认 true：/_host/rpc/* 需要先在 /admin 登录。
# 改配置的人能把 rpc_url 指向自己的服务器，而 direct 模式的 addUri
# 参数里带着网盘 Cookie —— 不设门就是凭据外泄通道。仅在可信内网才关。
RPC_REQUIRE_ADMIN=true
# 关掉整个 RPC 功能 / 只关页面上的注入按钮
# ARIA2_RPC_ENABLED=false
# INJECT_RPC_BUTTON=false
# 默认隐藏页面上的「生成短链」按钮（直接推 RPC 就够了）。
# 后端 /api/create-short 和 /s/ 路由不受影响，旧短链继续有效。
HIDE_SHORT_LINK=true

# ===== 出站代理（完全可选，绝大多数情况留空）=====
# 只在 JxPan 所在网络无法直连网盘时才需要：企业网 HTTPS 中间人、受限网络等。
# 注意三点，配错了 Node 不报错、只是静默不生效然后挂到超时：
#   1. 必须同时设 NODE_USE_ENV_PROXY=1，否则 Node 的 fetch 完全忽略代理
#      （该开关需要 Node >= 22.21.0 或 >= 24.0.0；官方镜像是 node:24，没问题）
#   2. NO_PROXY 只认具体 IP / 主机名 / 域名后缀，**不支持 192.168.1.0/24 这种网段写法**
#   3. NO_PROXY 至少写上 127.0.0.1,localhost，否则健康检查和本机 Aria2 RPC 也会走代理
# 启动日志会打印代理状态并对上述问题给出告警。
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://192.168.1.10:8080
# HTTPS_PROXY=http://192.168.1.10:8080
# NO_PROXY=127.0.0.1,localhost,192.168.1.20

# 让 Node 读操作系统证书库（企业网装了自签根证书时需要）。
# 需要 Node >= 22.19.0 / >= 24.6.0。或者用 NODE_EXTRA_CA_CERTS 指定 PEM 文件。
# NODE_USE_SYSTEM_CA=1

# ===== 安全 =====
# 默认 true：未带管理员 cookie 时，/?action=login_status 不返回凭据明文。
# 设 false 会恢复成与 Cloudflare 部署一致的行为（凭据裸奔），不建议。
PROTECT_CREDENTIALS=true
# 默认 true：没有有效 admin_token 时，浏览器打开首页 302 到 /admin。
# 网盘凭据全靠后台录入，没登录过的实例点解析必然失败，先送去登录。
# 只拦 Accept: text/html 的首页请求；type=down（aria2 回连）、action=（前端 XHR）、
# /admin、/s/ 短链、/_host/* 都不受影响。想开放访问就设 false。
HOME_REQUIRE_ADMIN=true
# 扫码凭据自动落库，默认 true
QR_AUTOSAVE=true

# ===== 解析行为 =====
# 缓存开关与过期秒数
CACHE=
CACHE_EXPIRED=
FOLDER_CACHE=
# 输出模式 / 302 目标
MODE=
REDIRECT_URL=
AUTO_SWITCH=
